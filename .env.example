# MongoDB
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/civic_complaints?retryWrites=true&w=majority
MONGODB_DB_NAME=humanizr

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI - Gemini (preferred) or OpenAI
# Gemini — multimodal complaint classification (text + images). Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=your_openai_api_key
AI_PROVIDER=gemini

# App URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# CORS
CORS_ORIGINS=http://localhost:3000

# Optional split AI microservice (leave empty to use embedded pipeline)
AI_SERVICE_URL=

# BullMQ (Redis + queue service in /queue)
REDIS_URL=redis://127.0.0.1:6380
QUEUE_SERVICE_URL=http://127.0.0.1:3030
COMPLAINT_AI_QUEUE_NAME=complaint-ai
INTERNAL_API_KEY=dev-internal-key
QUEUE_HTTP_PORT=3030

# Cluster detection
CLUSTER_MIN_COMPLAINTS=5
CLUSTER_RADIUS_METERS=500

# SMTP (optional — password reset logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=humanizr@localhost

# Azure (production)
AZURE_CONTAINER_REGISTRY=yourregistry.azurecr.io
AZURE_WEBAPP_NAME=civic-complaints-api
